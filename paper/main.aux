\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {When the certificate fails} (row E7, lift height 20\,cm, B5, $r=1.2$). (a) The demand peaks at 95\% of the true static capacity, just below the certified level, so Coulomb friction should hold the rod. (b) The soft contact creeps at up to 12\,mm/s before peak acceleration; the emulator's kinetic switch, which reads the relative speed with a one-step lag that adds about 8\,mm/s here, fires at a true relative speed of 12\,mm/s (kinetic friction shaded), and the rod slides. (c) The certified lift ends 6\,mm low.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:e7case}{{8}{10}{\textbf {When the certificate fails} (row E7, lift height 20\,cm, B5, $r=1.2$). (a) The demand peaks at 95\% of the true static capacity, just below the certified level, so Coulomb friction should hold the rod. (b) The soft contact creeps at up to 12\,mm/s before peak acceleration; the emulator's kinetic switch, which reads the relative speed with a one-step lag that adds about 8\,mm/s here, fires at a true relative speed of 12\,mm/s (kinetic friction shaded), and the rod slides. (c) The certified lift ends 6\,mm low}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Action-space safety map.} Fixed residual actions on the 40 test objects: lift time (columns) against grip relative to the model's grip for that lift time (rows). (a, b) Percentage of failed lifts without a shield at $r=1.0$ and $r=1.2$. (c) With the grip shield. (d) Mean grip relative to the object's weight after the shield. Circles mark the mean effective actions of the five trained B2 policies.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:safetymap}{{9}{10}{\textbf {Action-space safety map.} Fixed residual actions on the 40 test objects: lift time (columns) against grip relative to the model's grip for that lift time (rows). (a, b) Percentage of failed lifts without a shield at $r=1.0$ and $r=1.2$. (c) With the grip shield. (d) Mean grip relative to the object's weight after the shield. Circles mark the mean effective actions of the five trained B2 policies}{figure.caption.11}{}}
