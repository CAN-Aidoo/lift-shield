\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Episode pipeline.} A wrist weight estimate and a reactive probe give the breakaway grip $F_{\mathrm  {stuck}}$; the friction-model controller proposes a lift; the residual policy rescales its duration and grip; the shield evaluates Proposition~\ref {prop:lift} and, if the slip bound exceeds 3.5\,mm, raises the grip (grip axis) or lengthens the lift (time axis) until it does not, declining if neither suffices. Then the gripper lifts the object 10\,cm along a minimum-jerk profile and holds for 0.3\,s.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:method}{{2}{3}{\textbf {Episode pipeline.} A wrist weight estimate and a reactive probe give the breakaway grip $\Fs $; the friction-model controller proposes a lift; the residual policy rescales its duration and grip; the shield evaluates Proposition~\ref {prop:lift} and, if the slip bound exceeds 3.5\,mm, raises the grip (grip axis) or lengthens the lift (time axis) until it does not, declining if neither suffices. Then the gripper lifts the object 10\,cm along a minimum-jerk profile and holds for 0.3\,s}{figure.caption.1}{}}
